# Copy to .env (repo root). Unset DATABASE_URL = SQLite file at backend/meridian.db.
# DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5432/meridian

# Tests only. Point at a PostgreSQL 17 database whose Meridian tables may be dropped and
# recreated (other objects in it are left alone). Unset = PG tests are skipped.
# Hosted: use the DIRECT / session connection string, not a transaction-mode pooler
# (psycopg prepares statements), and keep sslmode=require. A pasted postgresql:// or
# postgres:// URL is fine; it is mapped to the psycopg driver.
#   Neon:     postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# TEST_DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5432/meridian_test
